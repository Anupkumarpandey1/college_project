# Server Port
PORT=5000

# Node Environment (set to 'production' to enable self-ping keep-alive)
NODE_ENV=development

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# Frontend URL (for CORS)
# Local development: http://localhost:5173
# Production: https://your-frontend-url.vercel.app
FRONTEND_URL=http://localhost:5173

# CodeArena Judge0 API (Free via RapidAPI)
# Sign up: https://rapidapi.com/CodeArena/api/codearena-advanced-code-compiler
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge029.p.rapidapi.com

# Render External URL (auto-set by Render, used for self-ping)
# Only needed in production, Render sets this automatically
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
